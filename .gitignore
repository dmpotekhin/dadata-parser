# Кэш Python
__pycache__/
*.py[cod]

# Секреты: реальный токен DaData живёт только в .env, в git он не попадает
.env
.env.*
!.env.example

# Состояние прогонов: суточный счётчик, кэш ИНН, lock-файл
dadata_state.json
*_state.json
*.lock

# Результаты прогонов (входной inn.xlsx и выходные отчёты)
inn_okved*.xlsx
*_dryrun.xlsx
# CodeGraph local index (per-machine, do not commit)
.codegraph/
