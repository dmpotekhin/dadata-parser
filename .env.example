# Шаблон. Скопируйте в .env рядом с этим файлом:
#     cp .env.example .env && chmod 600 .env
# и вставьте реальный токен. Файл .env в git не попадает (см. .gitignore).
#
# Токен: https://dadata.ru/profile/#info
DADATA_TOKEN=

# Необязательно: адрес API. По умолчанию официальный endpoint DaData.
# Меняйте только для локального мок-сервера в тестах.
#DADATA_API_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party
